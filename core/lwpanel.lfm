object LWPanelForm: TLWPanelForm
  Left = 320
  Height = 440
  Top = 220
  Width = 680
  Caption = 'lazarusWeb 独立服务器'
  ClientHeight = 415
  ClientWidth = 680
  Color = clBtnFace
  Constraints.MinHeight = 280
  Constraints.MinWidth = 460
  Font.Height = -12
  Font.Name = 'Segoe UI'
  Font.Style = []
  Menu = mmMain
  Position = poScreenCenter
  OnClose = FormClose
  object memLog: TMemo
    Left = 0
    Height = 415
    Top = 0
    Width = 680
    Align = alClient
    Font.Height = -12
    Font.Name = 'Consolas'
    Font.Style = []
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssAutoBoth
    TabOrder = 0
    WordWrap = False
  end
  object sbMain: TStatusBar
    Left = 0
    Height = 25
    Top = 415
    Width = 680
    Align = alBottom
    SimplePanel = False
    Panels = <
      item
        Width = 260
      end
      item
        Width = 110
      end
      item
        Width = 140
      end>
  end
  object mmMain: TMainMenu
    Left = 8
    Top = 8
    object mnuFile: TMenuItem
      Caption = '文件(&F)'
      object mniOpen: TMenuItem
        Caption = '打开浏览器(&B)'
        OnClick = DoOpen
        ShortCut = 116
      end
      object mniCopy: TMenuItem
        Caption = '复制访问地址(&C)'
        OnClick = DoCopy
      end
      object mniSep1: TMenuItem
        Caption = '-'
      end
      object mniExit: TMenuItem
        Caption = '退出(&X)'
        OnClick = DoExitMenu
      end
    end
    object mnuAdmin: TMenuItem
      Caption = '管理(&M)'
      object mniClear: TMenuItem
        Caption = '清空日志(&L)'
        OnClick = DoClear
      end
      object mniVerbose: TMenuItem
        Caption = '详细日志（每个请求）'
        OnClick = DoVerbose
      end
      object mniSep2: TMenuItem
        Caption = '-'
      end
      object mniAbout: TMenuItem
        Caption = '关于(&A)'
        OnClick = DoAbout
      end
    end
  end
  object pmTray: TPopupMenu
    Left = 40
    Top = 8
    object mniTrayShow: TMenuItem
      Caption = '打开面板(&P)'
      Default = True
      OnClick = TrayClick
    end
    object mniTrayOpen: TMenuItem
      Caption = '打开浏览器(&B)'
      OnClick = DoOpen
    end
    object mniTraySep: TMenuItem
      Caption = '-'
    end
    object mniTrayExit: TMenuItem
      Caption = '退出(&X)'
      OnClick = DoExitMenu
    end
  end
  object trayMain: TTrayIcon
    BalloonTitle = 'lazarusWeb 仍在运行'
    BalloonTimeout = 5000
    PopUpMenu = pmTray
    OnClick = TrayClick
    Left = 72
    Top = 8
  end
  object tmrMain: TTimer
    Enabled = False
    Interval = 800
    OnTimer = tmrMainTimer
    Left = 104
    Top = 8
  end
end
