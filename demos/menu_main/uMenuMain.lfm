object MenuMainForm: TMenuMainForm
  Left = 200
  Height = 1050
  Top = 80
  Width = 1620
  Caption = 'lazarusWeb · 标准 MainMenu 菜单 + LCL 控件联动（Alpine.js）'
  ClientHeight = 1050
  ClientWidth = 1620
  Color = clBtnFace
  DesignTimePPI = 144
  Font.CharSet = GB2312_CHARSET
  Font.Color = clWindowText
  Font.Height = -20
  Font.Name = 'Microsoft YaHei'
  Menu = mnuMain
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  object mnuMain: TMainMenu
    left = 24
    top = 1030
    object mnuTheory: TMenuItem
      Caption = '从业人员理论考核'
      object miSignup: TMenuItem
        Caption = '报名查询'
        OnClick = MenuItemClick
      end
      object miScore: TMenuItem
        Caption = '成绩查询'
        OnClick = MenuItemClick
      end
      object miStat: TMenuItem
        Caption = '成绩统计'
        OnClick = MenuItemClick
      end
      object miSchedule: TMenuItem
        Caption = '考试安排表下载'
        OnClick = MenuItemClick
      end
    end
    object mnuExam: TMenuItem
      Caption = '考试管理'
      object miExamPlan: TMenuItem
        Caption = '考试计划'
        OnClick = MenuItemClick
      end
      object miExamRoom: TMenuItem
        Caption = '考场安排'
        OnClick = MenuItemClick
      end
      object miExamInv: TMenuItem
        Caption = '监考人员'
        OnClick = MenuItemClick
      end
    end
    object mnuQual: TMenuItem
      Caption = '资质管理'
      object miQualEnt: TMenuItem
        Caption = '企业资质'
        OnClick = MenuItemClick
      end
      object miQualCert: TMenuItem
        Caption = '人员证书'
        OnClick = MenuItemClick
      end
    end
    object mnuHelp: TMenuItem
      Caption = '帮助'
      object miSep1: TMenuItem
        Caption = '-'
      end
      object miAbout: TMenuItem
        Caption = '关于'
        OnClick = MenuItemClick
      end
    end
  end
  object pnlTop: TPanel
