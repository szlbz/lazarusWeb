object FileForm: TFileForm
  Left = 220
  Top = 120
  Width = 780
  Height = 540
  Caption = 'lazarusWeb · 文件上传 / 下载'
  ClientHeight = 540
  ClientWidth = 780
  Color = clBtnFace
  Font.Charset = GB2312_CHARSET
  Font.Color = clWindowText
  Font.Height = -13
  Font.Name = 'Microsoft YaHei'
  Font.Style = []
  OnCreate = FormCreate
  ExplicitWidth = 796
  ExplicitHeight = 579
  object lblTitle: TLabel
    Left = 24
    Top = 14
    Width = 520
    Height = 25
    Caption = '上传文件到服务端，或把服务端文件下载回浏览器'
    Font.Height = -19
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblHint: TLabel
    Left = 24
    Top = 48
    Width = 700
    Height = 17
    Caption = '上传：文件落在服务端临时目录，OnUpload 拿到完整路径；下载：业务代码调 SendFile / SendText'
    Font.Color = clGray
    ParentFont = False
  end
  object btnUpload: TLWFileUpload
    Left = 24
    Top = 78
    Width = 210
    Height = 34
    Caption = '选择文件并上传…'
    TabOrder = 0
    Filter = '文本/CSV|*.txt;*.csv;*.log|图片|*.png;*.jpg;*.gif|所有文件|*.*'
    Multiple = True
    MaxSizeKB = 8192
    OnUpload = btnUploadUpload
  end
  object lblStatus: TLabel
    Left = 250
    Top = 86
    Width = 500
    Height = 19
    Caption = '（还没有上传）'
    Font.Color = clNavy
    ParentFont = False
  end
  object lblList: TLabel
    Left = 24
    Top = 124
    Width = 200
    Height = 17
    Caption = '服务端已收到的文件'
  end
  object lstFiles: TListBox
    Left = 24
    Top = 146
    Width = 340
    Height = 170
    ItemHeight = 17
    TabOrder = 1
    OnDblClick = lstFilesDblClick
  end
  object btnDownload: TButton
    Left = 380
    Top = 146
    Width = 150
    Height = 30
    Caption = '下载所选文件'
    TabOrder = 2
    OnClick = btnDownloadClick
  end
  object btnExport: TButton
    Left = 380
    Top = 184
    Width = 150
    Height = 30
    Caption = '导出清单 CSV'
    TabOrder = 3
    OnClick = btnExportClick
  end
  object btnClear: TButton
    Left = 380
    Top = 222
    Width = 150
    Height = 30
    Caption = '清空列表'
    TabOrder = 4
    OnClick = btnClearClick
  end
  object lblDrop: TLabel
    Left = 380
    Top = 264
    Width = 360
    Height = 52
    Caption = '提示：下载链接是一次性令牌，URL 里不会出现服务端路径。'
    Font.Color = clGray
    ParentFont = False
    WordWrap = True
  end
  object mmoLog: TMemo
    Left = 24
    Top = 330
    Width = 730
    Height = 190
    Lines.Strings = (
      '服务端日志：')
    ScrollBars = ssVertical
    TabOrder = 5
  end
end
