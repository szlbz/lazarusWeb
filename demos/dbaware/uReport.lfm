object ReportForm: TReportForm
  Left = 0
  Height = 700
  Top = 0
  Width = 1040
  Caption = '报表中心 · 打印与导出'
  ClientHeight = 700
  ClientWidth = 1040
  OnCreate = FormCreate
  object lblTitle: TLabel
    Left = 16
    Height = 26
    Top = 12
    Width = 720
    Caption = '报表中心 —— 预览 / 打印 / 导出（lwreport 报表引擎）'
    Font.Color = clNavy
    Font.Height = -17
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblSourceCap: TLabel
    Left = 16
    Height = 18
    Top = 52
    Width = 60
    Caption = '数据源'
  end
  object cbSource: TComboBox
    Left = 80
    Height = 26
    Top = 48
    Width = 200
    ItemIndex = 1
    Items.Strings = (
      '商品清单（items）'
      '库存大表（bigitems · 240 行）')
    Style = csDropDownList
    TabOrder = 0
    OnChange = cbSourceChange
  end
  object btnPreview: TButton
    Left = 292
    Height = 28
    Top = 48
    Width = 104
    Caption = '刷新预览'
    TabOrder = 1
    OnClick = btnPreviewClick
  end
  object btnPrint: TButton
    Left = 404
    Height = 28
    Top = 48
    Width = 104
    Caption = '打印…'
    TabOrder = 2
    OnClick = btnPrintClick
  end
  object btnCSV: TButton
    Left = 516
    Height = 28
    Top = 48
    Width = 104
    Caption = '导出 CSV'
    TabOrder = 3
    OnClick = btnCSVClick
  end
  object btnXLSX: TButton
    Left = 628
    Height = 28
    Top = 48
    Width = 112
    Caption = '导出 Excel'
    TabOrder = 4
    OnClick = btnXLSXClick
  end
  object btnBack: TButton
    Left = 900
    Height = 28
    Top = 48
    Width = 124
    Caption = '返回主界面'
    TabOrder = 5
    OnClick = btnBackClick
  end
  object lblInfo: TLabel
    Left = 16
    Height = 20
    Top = 84
    Width = 1000
    Caption = '（尚未生成）'
    Font.Color = clNavy
    ParentFont = False
  end
  object lblHint: TLabel
    Left = 16
    Height = 18
    Top = 104
    Width = 1000
    Caption = 
      '预览页顶部有「打印 / 另存为 PDF」按钮（走浏览器打印引擎，A4 版式、表头逐页重复）；' +
      '本页的「打印…」会直接弹出打印对话框。'
    Font.Color = clGray
    ParentFont = False
  end
  object view: TLWPDFFrame
    Left = 16
    Height = 556
    Top = 128
    Width = 1008
    BorderStyle = bsSingle
    TabOrder = 6
  end
end
