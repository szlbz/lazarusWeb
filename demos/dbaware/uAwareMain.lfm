        Font.Style = [fsBold]
        ParentFont = False
      end
      object frAjax: TLWHTMLFrame
        Left = 930
        Height = 264
        Top = 387
        Width = 570
        HTML.Strings = (
          '<div style="font:13px system-ui,Segoe UI,sans-serif;padding:6px"><button id="lwAjaxBtn" style="padding:5px 10px;cursor:pointer">GET /lw/ajax/items</button> <button id="lwAjaxWho" style="padding:5px 10px;cursor:pointer">GET /lw/ajax/whoami?sid=</button><pre id="lwAjaxOut" style="margin:8px 0 0 0;height:104px;overflow:auto;background:#f7f9fc;border:1px solid #dbe3ec;padding:6px;font-size:12px">点上面的按钮试试</pre></div><script>function lwAjaxShow(t){document.getElementById("lwAjaxOut").textContent=t;}document.getElementById("lwAjaxBtn").onclick=function(){ fetch("/lw/ajax/items?limit=3").then(function(r){return r.json();}) .then(function(j){lwAjaxShow(JSON.stringify(j,null,1));}) .catch(function(e){lwAjaxShow("请求失败: "+e);});};document.getElementById("lwAjaxWho").onclick=function(){ var sid=(window.LW&&LW.sid)?LW.sid():""; fetch("/lw/ajax/whoami?sid="+encodeURIComponent(sid)) .then(function(r){return r.json();}) .then(function(j){lwAjaxShow(JSON.stringify(j,null,1));}) .catch(function(e){lwAjaxShow("请求失败: "+e);});};</script>'
        )
        TabOrder = 14
      end
    end
