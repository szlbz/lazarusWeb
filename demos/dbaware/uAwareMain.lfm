    object tsHTML: TTabSheet
      Caption = 'HTML 展示'
      ClientHeight = 1043
      ClientWidth = 1642
      object lblHtmlTitle: TLabel
        Left = 18
        Height = 31
        Top = 15
        Width = 892
        Caption = 'TLWHTMLFrame —— 面板内渲染任意 HTML（对应 uniGUI 的 uniHTMLFrame）'
        Font.Height = -23
        Font.Style = [fsBold]
        ParentFont = False
      end
      object mmHtml: TMemo
        Left = 18
        Height = 540
        Top = 54
        Width = 780
        Lines.Strings = (
          '<h2 style="color:#2255aa;margin:4px 0">TLWHTMLFrame · 富文本面板</h2>'
          '<p>这段 HTML 由<b>服务端 Pascal 代码</b>提供，等价于 uniGUI 的 uniHTMLFrame。</p>'
          '<ul>'
          '<li>支持任意 HTML / 内联 CSS</li>'
          '<li>运行时改 HTML 属性，浏览器端增量更新（不重建面板）</li>'
          '<li>可与数据绑定、对话框、上传等框架能力自由组合</li>'
          '</ul>'
          '<table border="1" cellpadding="4" style="border-collapse:collapse">'
          '<tr style="background:#dde"><th>lazarusWeb</th><th>uniGUI</th></tr>'
          '<tr><td>TLWHTMLFrame</td><td>uniHTMLFrame</td></tr>'
          '<tr><td>TLWPDFFrame</td><td>uniPDFFrame</td></tr>'
          '<tr><td>TLWFileUpload</td><td>uniFileUpload</td></tr>'
          '</table>'
          '<p style="color:#888">在左边编辑 HTML 源码，点下面按钮立即刷新右下面板。</p>'
        )
        ScrollBars = ssVertical
        TabOrder = 0
      end
      object btnHtmlApply: TButton
        Left = 18
        Height = 42
        Top = 606
        Width = 255
        Caption = '应用到下方面板'
        TabOrder = 1
        OnClick = btnHtmlApplyClick
      end
      object htmlFrame: TLWHTMLFrame
        Left = 18
        Height = 315
        Top = 660
        Width = 1590
        HTML.Strings = (
          '<h2 style="color:#2255aa;margin:4px 0">TLWHTMLFrame · 富文本面板</h2>'
          '<p>这段 HTML 由<b>服务端 Pascal 代码</b>提供，等价于 uniGUI 的 uniHTMLFrame。</p>'
          '<ul>'
          '<li>支持任意 HTML / 内联 CSS</li>'
          '<li>运行时改 HTML 属性，浏览器端增量更新（不重建面板）</li>'
          '<li>可与数据绑定、对话框、上传等框架能力自由组合</li>'
          '</ul>'
          '<table border="1" cellpadding="4" style="border-collapse:collapse">'
          '<tr style="background:#dde"><th>lazarusWeb</th><th>uniGUI</th></tr>'
          '<tr><td>TLWHTMLFrame</td><td>uniHTMLFrame</td></tr>'
          '<tr><td>TLWPDFFrame</td><td>uniPDFFrame</td></tr>'
          '<tr><td>TLWFileUpload</td><td>uniFileUpload</td></tr>'
          '</table>'
          '<p style="color:#888">在左边编辑 HTML 源码，点下面按钮立即刷新右下面板。</p>'
        )
        TabOrder = 2
      end
    end
