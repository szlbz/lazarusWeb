    ParentFont = False
  end
  object lblName: TLabel
    Left = 24
    Top = 64
    Width = 60
    Height = 17
    Caption = '你的名字'
  end
  object edtName: TEdit
    Left = 96
    Top = 60
    Width = 200
    Height = 27
    TabOrder = 0
