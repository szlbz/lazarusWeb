object MainForm: TMainForm
  Left = 0
  Height = 420
  Top = 0
  Width = 640
  Caption = 'lazarusWeb · 登录后的主窗体'
  ClientHeight = 420
  ClientWidth = 640
  OnCreate = FormCreate
  object lblTitle: TLabel
    Left = 24
    Height = 24
    Top = 24
    Width = 560
    Caption = '欢迎回来！认证通过后才会创建这个窗体。'
    Font.Height = -16
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblUser: TLabel
    Left = 24
    Height = 20
    Top = 60
    Width = 560
    Caption = '当前用户：'
  end
  object btnToast: TButton
    Left = 24
    Height = 30
    Top = 100
    Width = 150
    Caption = '来一条 Toast'
    TabOrder = 0
    OnClick = DoToast
  end
  object btnLogout: TButton
    Left = 190
    Height = 30
    Top = 100
    Width = 150
    Caption = '退出登录'
    TabOrder = 1
    OnClick = DoLogout
  end
end
